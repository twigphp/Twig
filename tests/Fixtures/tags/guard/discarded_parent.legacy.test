--TEST--
"guard" ignores the parent defined in the discarded branch
--DEPRECATION--
Since twig/twig 3.28: Using the "extends" tag outside the root of a template is deprecated in index.twig at line 2.
--TEMPLATE--
{% guard function foobar %}{% extends "never.twig" %}{% else %}{% extends "layout.twig" %}{% endguard %}
{% block content %}content{% endblock %}
--TEMPLATE(layout.twig)--
layout {{ block('content') }}
--TEMPLATE(never.twig)--
NEVER
--DATA--
return []
--EXPECT--
layout content
