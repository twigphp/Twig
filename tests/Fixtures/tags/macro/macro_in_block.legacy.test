--TEST--
"macro" tag in a block
--DEPRECATION--
Since twig/twig 3.27: Using the "macro" tag outside the root of a template is deprecated in index.twig at line 3.
--TEMPLATE--
{% block foo %}
    {% macro input(name, value, type, size) %}
        <input type="{{ type|default("text") }}" name="{{ name }}" value="{{ value|e|default('') }}" size="{{ size|default(20) }}">
    {% endmacro %}
{% endblock %}
--DATA--
return []
--EXPECT--
