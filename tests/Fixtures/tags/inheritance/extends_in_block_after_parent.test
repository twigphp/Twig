--TEST--
"extends" tag in a block after a parent has been defined
--TEMPLATE--
{% extends "base.twig" %}

{% block foo %}
    {% extends "foo.twig" %}
{% endblock %}
--TEMPLATE(base.twig)--
--TEMPLATE(foo.twig)--
--DATA--
return []
--EXCEPTION--
Twig\Error\SyntaxError: Cannot use "extend" in a block in "index.twig" at line 5.
