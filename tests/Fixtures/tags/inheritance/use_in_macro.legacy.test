--TEST--
"use" tag in a macro
--DEPRECATION--
Since twig/twig 3.27: Using the "use" tag outside the root of a template is deprecated in index.twig at line 3.
--TEMPLATE--
{% macro input(name, value, type, size) %}
    {% use "base.twig" %}

    <input type="{{ type|default("text") }}" name="{{ name }}" value="{{ value|e|default('') }}" size="{{ size|default(20) }}">
{% endmacro %}
--TEMPLATE(base.twig)--
--DATA--
return []
--EXPECT--
