--TEST--
"any" filter
--TEMPLATE--
{{ [1, 2]|any((v) => v > 3) ? 'true' : 'false' }}
{{ [1, 2, 3, 4, 5]|any(v => v > 3) ? 'true' : 'false' }}
{{ {a: 1, b: 2, c: 5, d: 8}|any(v => v > 3) ? 'true' : 'false' }}
{{ {a: 1, b: 2, c: 5, d: 8}|any((v, k) => (v > 3) and (k != "c")) ? 'true' : 'false' }}
{{ it|any((v) => v > 3) ? 'true' : 'false' }}
{{ ita|any(v => v > 3) ? 'true' : 'false' }}
--DATA--
return [
    'it' => new \ArrayIterator(['a' => 1, 'b' => 2, 'c' => 5, 'd' => 8]),
    'ita' => new Twig\Tests\IteratorAggregateStub(['a' => 1, 'b' => 2, 'c' => 5, 'd' => 8]),
]
--EXPECT--
false
true
true
true
true
true
