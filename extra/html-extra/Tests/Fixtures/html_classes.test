*{{ html_classes('a', '', 'b') }}*
*{{ html_classes('0', '0', '1', '01') }}*
*{{ html_classes('a b', 'a', 'b') }}*
*{{ html_classes(' a ', 'a') }}*
*{{ html_classes() }}*
